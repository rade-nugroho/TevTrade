# Ollama
# Local default is http://127.0.0.1:11434. Set the URL to https://ollama.com to use a cloud model.
# OLLAMA_URL_ENPOINT is the legacy spelling and still works.
# Decision model: Ollama tag tev1:0.8b (togethercomputer/Tev1-0.8B-experimental).
# vLLM uses that Hugging Face id. Point OLLAMA_URL_ENDPOINT at the server's /v1 root, on a port other than TypeDB.
OLLAMA_API_KEY=
OLLAMA_URL_ENDPOINT=
OLLAMA_URL_ENPOINT=
OLLAMA_MODEL=tev1:0.8b

# Helius RPC
# Use the devnet endpoint unless NEXT_PUBLIC_SOLANA_CLUSTER is changed to match.
# The browser calls /api/rpc, so the API key stays on the server.
# Example: HELIUS_URL=https://devnet.helius-rpc.com
HELIUS_API_KEY=
HELIUS_URL=

# Optional direct browser RPC. Leave empty to use the server proxy above.
NEXT_PUBLIC_SOLANA_RPC_URL=
# solana:devnet | solana:testnet | solana:mainnet | solana:localnet
NEXT_PUBLIC_SOLANA_CLUSTER=solana:devnet

# TypeDB
# HTTP API root, for example http://127.0.0.1:8000
TYPEDB_URL=
TYPEDB_TOKEN=
TYPEDB_DATABASE=tevtrade

# Titan Developers Portal
# Quotes are mainnet routes. The key stays on the server. The desk shows the route and does not sign it.
# Create a key at https://portal.titan.exchange
TITAN_API_KEY=
TITAN_API_URL=https://portal.api.titan.exchange

# Hugging Face
HF_TOKEN=
