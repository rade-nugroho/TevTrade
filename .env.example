# Ollama
# Local default is http://127.0.0.1:11434. Set the URL to https://ollama.com to use a cloud model.
# OLLAMA_URL_ENPOINT is the legacy spelling and still works.
# Decision model: Ollama tag tev1:0.8b (togethercomputer/Tev1-0.8B-experimental).
# vLLM uses that Hugging Face id. Point OLLAMA_URL_ENDPOINT at the server's /v1 root, on a port other than TypeDB.
OLLAMA_API_KEY=
OLLAMA_URL_ENDPOINT=
OLLAMA_URL_ENPOINT=
OLLAMA_MODEL=tev1:0.8b

# Helius RPC
# Use the matching cluster endpoint unless you run a local validator.
# On solana:localnet, the server ignores HELIUS_* and uses the local RPC below.
# The browser calls /api/rpc unless NEXT_PUBLIC_SOLANA_RPC_URL is set, so the API key stays on the server.
# Example: HELIUS_URL=https://devnet.helius-rpc.com
HELIUS_API_KEY=
HELIUS_URL=

# Optional direct browser RPC. Leave empty to use the server proxy (/api/rpc).
# Local validator (solana-test-validator): set both cluster and RPC so Helius cannot override.
# NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
# NEXT_PUBLIC_SOLANA_CLUSTER=solana:localnet
NEXT_PUBLIC_SOLANA_RPC_URL=
# solana:devnet | solana:testnet | solana:mainnet | solana:localnet
NEXT_PUBLIC_SOLANA_CLUSTER=solana:devnet

# TypeDB
# HTTP API root, for example http://127.0.0.1:8000
# Start locally with: typedb --config /opt/homebrew/etc/typedb/config.yml
# Token: POST http://127.0.0.1:8000/v1/signin with {"username":"admin","password":"password"}
# and set TYPEDB_TOKEN to the returned bearer token (JWT). Restart `npm run dev` after changing it.
TYPEDB_URL=http://127.0.0.1:8000
TYPEDB_TOKEN=
TYPEDB_DATABASE=tevtrade

# Optional public Solana address for Decision balance context when no Wallet Standard wallet is connected.
# Public key only — never a secret key, seed phrase, or path to id.json.
# Example: solana-keygen pubkey id.json
DESK_WALLET_ADDRESS=

# Titan quotes (mainnet only — desk does not sign)
# Default surface is free public DART (no key, 1 req/s per IP, DART provider only).
# TITAN_QUOTE_SOURCE=dart | portal
TITAN_QUOTE_SOURCE=dart
TITAN_DART_URL=https://api.titan.exchange/dart
# Optional DART partner key (Bearer / X-API-Key). Not the Developers Portal key.
# Apply: https://tally.so/r/1AvYeL
TITAN_DART_API_KEY=

# Developers Portal (only when TITAN_QUOTE_SOURCE=portal)
# Portal keys do not work on /dart. DART keys do not work on portal.api.titan.exchange.
# Create a Portal key at https://portal.titan.exchange
TITAN_API_KEY=
TITAN_API_URL=https://portal.api.titan.exchange

# Titan Special Order Types (partner automation — not DART, not Portal quote)
# Scheduled/trigger orders: dca | stop_loss | take_profit | oco | slice
# Core flow: POST /orders/intent → Wallet Standard sign deposit → POST /orders/confirm
# Also: POST /partner/onboard (SIWS), GET /me, balances, list/pause/resume/cancel/withdraw
# Envelope: { success, data } | { success: false, error: { code, message, details } }
# Auth: X-Titan-Key (+ X-Titan-User for user-scoped). Keys stay on the server.
# Base URL has no trailing slash — use the partner environment URL from Titan docs (do not invent).
TITAN_DCA_BASE_URL=
TITAN_DCA_API_KEY=

# Titan Direct WebSocket SDK (server-only V1Client)
# TITAN_ENDPOINT is the host only, e.g. api.example.titan.exchange — no wss:// scheme.
# TITAN_JWT never goes in NEXT_PUBLIC_* or the browser bundle.
TITAN_ENDPOINT=
TITAN_JWT=

# Hugging Face
HF_TOKEN=

# React Bits Pro (shadcn registry auth)
REACTBITS_LICENSE_KEY=
